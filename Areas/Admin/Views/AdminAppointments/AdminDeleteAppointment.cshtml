@model OnlineCoursesPlatform.Entities.Appointment

@{
    ViewData["Title"] = "Delete Appointment";
}

<div class="container py-4">
    <h2>Delete Appointment</h2>

    <div class="alert alert-warning">
        <h4>Are you sure you want to delete this appointment?</h4>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <h5>Appointment Details</h5>
            <hr>

            <p><strong>Student:</strong> @Model.Student?.Email</p>
            <p><strong>Instructor:</strong> @Model.Instructor?.Name</p>
            <p><strong>Date:</strong> @Model.AppointmentDate.ToString("dd/MM/yyyy HH:mm")</p>
            <p><strong>Status:</strong> @Model.Status</p>

            @if (!string.IsNullOrEmpty(Model.Notes))
            {
                <p><strong>Notes:</strong> @Model.Notes</p>
            }
        </div>
    </div>

    <form asp-action="AdminDeleteConfirmed" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <button type="submit" class="btn btn-danger">Delete</button>
        <a href="/Admin/AdminAppointments/AdminIndex" class="btn btn-secondary">Cancel</a>
    </form>
</div>