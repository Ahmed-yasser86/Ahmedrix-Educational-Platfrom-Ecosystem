@model OnlineCoursesPlatform.Areas.Admin.Models.StartStreamViewModel

@{
    ViewData["Title"] = "Live Stream Room";
}

<div class="row">
    <div class="col-lg-10 mx-auto">
        <div class="card bg-dark text-white border-primary shadow-lg mb-4">
            <div class="card-header border-primary d-flex justify-content-between align-items-center">
                <h4 class="mb-0 text-primary"><i class="fas fa-broadcast-tower"></i> @Model.Title</h4>
                <span class="badge bg-secondary">Key: @Model.GeneratedStreamKey</span>
            </div>
            <div class="card-body text-center p-0 bg-black" style="min-height: 480px; position: relative; border-radius: 0 0 10px 10px;">

                <video id="preview" autoplay muted playsinline style="width: 100%; max-height: 600px;"></video>

                <div id="statusOverlay" class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center" style="background: rgba(0,0,0,0.6);">
                    <div class="status-text h4 text-warning" id="status">
                        <i class="fas fa-camera"></i> Step 1: Open camera to check signal
                    </div>
                </div>
            </div>
            <div class="card-footer bg-dark border-top-0 d-flex justify-content-center gap-3 py-3">
                <button id="open-cam" class="btn btn-primary btn-lg px-4">
                    <i class="fas fa-video"></i> 1. Start Camera
                </button>
                <button id="start-btn" class="btn btn-success btn-lg px-4" style="display: none;">
                    <i class="fas fa-play"></i> 2. Send Signal & Start Stream 🔴
                </button>
                <form asp-action="EndStream" method="post">
                    <input type="hidden" name="streamKey" value="@Model.GeneratedStreamKey" />
                    <button type="submit" class="btn btn-danger btn-lg px-4">
                        <i class="fas fa-stop-circle"></i> End Stream & Save Session
                    </button>
                </form>
               
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.socket.io/4.7.2/socket.io.min.js"></script>
    <script>
        let stream;
        let mediaRecorder;
        const socket = io('http://localhost:3001');
        const preview = document.getElementById('preview');
        const status = document.getElementById('status');
        const statusOverlay = document.getElementById('statusOverlay');
        const streamKey = "@Model.GeneratedStreamKey";

        document.getElementById('open-cam').onclick = async () => {
            try {
                stream = await navigator.mediaDevices.getUserMedia({
                    video: { width: 1280, height: 720 },
                    audio: true
                });
                preview.srcObject = stream;
                statusOverlay.style.background = "transparent";
                status.innerHTML = "<span class='badge bg-success'>Camera ready</span>";
                document.getElementById('open-cam').style.display = 'none';
                document.getElementById('start-btn').style.display = 'inline-block';
            } catch (err) {
                status.innerText = "Error: Could not access camera.";
            }
        };

        document.getElementById('start-btn').onclick = () => {
            socket.emit('start-stream', streamKey);

        var stopForm = document.getElementById('stop-form');
        if (stopForm) {
            stopForm.style.display = 'inline-block';
        }
            let options = { mimeType: 'video/webm;codecs=vp8,opus' };
            if (!MediaRecorder.isTypeSupported(options.mimeType)) {
                options = { mimeType: 'video/webm' };
            }

            mediaRecorder = new MediaRecorder(stream, options);
            mediaRecorder.ondataavailable = (event) => {
                if (event.data.size > 0) {
                    socket.emit('video-chunk', event.data);
                }
            };

            mediaRecorder.start(100);
            status.innerHTML = "🔴 <span class='text-danger fw-bold'>You are now live</span>";
            document.getElementById('start-btn').style.display = 'none';
            document.getElementById('stop-btn').style.display = 'inline-block';
        };

        socket.on('connect_error', () => {
            status.innerHTML = "<span class='text-danger'>Bridge server is offline!</span>";
        });
    </script>
}