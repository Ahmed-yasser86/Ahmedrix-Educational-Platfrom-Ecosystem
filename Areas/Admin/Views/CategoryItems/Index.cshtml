@{
    Layout = "/Areas/Admin/Views/Shared/_Layout.cshtml";
}
@model IEnumerable<OnlineCoursesPlatform.Entities.CategoryItem>
@{
    ViewData["Title"] = "Category Items";
    var categoryId = ViewBag.Categoryid as int? ?? 0;
}

<div class="container-fluid">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0 text-gray-800">
                <i class="fas fa-list text-primary me-2"></i>
                Category Items Management
            </h1>
            <div class="breadcrumb">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item">
                            <a asp-area="Admin" asp-controller="Category" asp-action="Index">Categories</a>
                        </li>
                        <li class="breadcrumb-item active">Items</li>
                    </ol>
                </nav>
            </div>
        </div>
        <div>
            <a asp-area="Admin" asp-controller="CategoryItems" asp-action="Create" asp-route-categoryId="@categoryId"
               class="btn btn-primary">
                <i class="fas fa-plus me-2"></i>Create New Item
            </a>
            <a asp-area="Admin" asp-controller="Category" asp-action="Index"
               class="btn btn-outline-secondary ms-2">
                <i class="fas fa-arrow-left me-2"></i>Back to Categories
            </a>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="row mb-4">
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-primary shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                                Total Items
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.Count()</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-list fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-success shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                                With Content
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">
                                @Model.Count(i => i.contentId > 0)
                            </div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-file-alt fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-info shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-info text-uppercase mb-1">
                                Latest Update
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">
                                @(Model.Any() ? Model.Max(m => m.DateTimeItemAdded).ToString("MMM dd") : "N/A")
                            </div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-calendar-alt fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-warning shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">
                                Status
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">
                                <span class="badge bg-success">Active</span>
                            </div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-check-circle fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Items Table -->
    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex justify-content-between align-items-center">
            <h6 class="m-0 font-weight-bold text-primary">Category Items</h6>
            <div class="d-flex gap-2">
                <div class="input-group input-group-sm" style="width: 250px;">
                    <input type="text" class="form-control" placeholder="Search items..." id="searchInput">
                    <button class="btn btn-outline-primary" type="button">
                        <i class="fas fa-search"></i>
                    </button>
                </div>
            </div>
        </div>
        <div class="card-body">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover" id="itemsTable">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Title</th>
                                <th>Description</th>
                                <th>Date Added</th>
                                <th>Content</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var (item, index) in Model.Select((item, index) => (item, index + 1)))
                            {
                                <tr>
                                    <td>@index</td>
                                    <td>
                                        <strong>@item.Title</strong>
                                    </td>
                                    <td>
                                        <small class="text-muted">
                                            @(item.Description?.Length > 80 ? item.Description.Substring(0, 80) + "..." : item.Description ?? "No description")
                                        </small>
                                    </td>
                                    <td>
                                        <span class="text-nowrap">
                                            <i class="fas fa-calendar-alt text-muted me-1"></i>
                                            @item.DateTimeItemAdded.ToString("MMM dd, yyyy")
                                        </span>
                                    </td>
                                    <td>
                                        @if (item.contentId > 0)
                                        {
                                            <span class="badge bg-success">
                                                <i class="fas fa-check-circle me-1"></i>Content Added
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning">
                                                <i class="fas fa-exclamation-circle me-1"></i>No Content
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <div class="btn-group btn-group-sm" role="group">
                                            <!-- Edit Item -->
                                            <a asp-area="Admin" asp-controller="CategoryItems" asp-action="Edit" asp-route-id="@item.Id"
                                               class="btn btn-outline-primary" title="Edit Item">
                                                <i class="fas fa-edit"></i>
                                            </a>

                                            <!-- View Details -->
                                            <a asp-area="Admin" asp-controller="CategoryItems" asp-action="Details" asp-route-id="@item.Id"
                                               class="btn btn-outline-info" title="View Details">
                                                <i class="fas fa-eye"></i>
                                            </a>

                                            <!-- Content Management -->
                                            @if (item.contentId > 0)
                                            {
                                                <a asp-area="Admin" asp-controller="Content" asp-action="Edit" asp-route-id="@item.contentId"
                                                   class="btn btn-outline-success" title="Edit Content">
                                                    <i class="fas fa-file-edit"></i>
                                                </a>
                                            }
                                            else
                                            {
                                                <a asp-area="Admin" asp-controller="Content" asp-action="Create"
                                                   asp-route-categoryItemId="@item.Id" asp-route-categoryId="@item.CategoryId"
                                                   class="btn btn-outline-warning" title="Add Content">
                                                    <i class="fas fa-plus-circle"></i>
                                                </a>
                                            }

                                            <!-- Delete -->
                                            <a asp-area="Admin" asp-controller="CategoryItems" asp-action="Delete" asp-route-id="@item.Id"
                                               class="btn btn-outline-danger" title="Delete">
                                                <i class="fas fa-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <!-- Empty State -->
                <div class="text-center py-5">
                    <div class="mb-4">
                        <i class="fas fa-list fa-4x text-gray-300"></i>
                    </div>
                    <h4 class="text-gray-700 mb-3">No Items Found</h4>
                    <p class="text-gray-500 mb-4">Start building your category by creating your first item</p>
                    <a asp-area="Admin" asp-controller="CategoryItems" asp-action="Create" asp-route-categoryId="@categoryId"
                       class="btn btn-primary">
                        <i class="fas fa-plus me-2"></i>Create First Item
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Search functionality
        document.getElementById('searchInput').addEventListener('keyup', function() {
            const searchTerm = this.value.toLowerCase();
            const rows = document.querySelectorAll('#itemsTable tbody tr');

            rows.forEach(row => {
                const text = row.textContent.toLowerCase();
                row.style.display = text.includes(searchTerm) ? '' : 'none';
            });
        });

        // Initialize tooltips
        document.addEventListener('DOMContentLoaded', function() {
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[title]'));
            var tooltipList = tooltipTriggerList.map(function(tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });
        });
    </script>
}

<style>
    .table-hover tbody tr:hover {
        background-color: rgba(0, 123, 255, 0.05);
    }

    .btn-group .btn {
        border-radius: 0.375rem !important;
        margin-right: 2px;
    }

    .badge {
        font-size: 0.85em;
        padding: 0.35em 0.65em;
    }

    .card {
        border: none;
        border-radius: 10px;
    }

    .card-header {
        background-color: #f8f9fc;
        border-bottom: 1px solid #e3e6f0;
        border-radius: 10px 10px 0 0 !important;
    }

    .breadcrumb {
        background: transparent;
        padding: 0;
        margin-bottom: 0;
    }

    .breadcrumb-item + .breadcrumb-item::before {
        content: "›";
    }
</style>