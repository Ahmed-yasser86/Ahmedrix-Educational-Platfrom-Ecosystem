@model IEnumerable<OnlineCoursesPlatform.Entities.CategoryItem>
@{
    
    ViewData["Title"] = "Category Items";
}

@section Styles {
    <link rel="stylesheet" href="~/css/category-items.css?v=@DateTime.Now.Ticks" />
}

<div class="category-items-container">
    <!-- Header Section -->
    <div class="items-header">
        <div class="header-content">
            <div class="header-text">
                <h1 class="page-title">
                    <span class="title-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="8" y1="6" x2="21" y2="6"></line>
                            <line x1="8" y1="12" x2="21" y2="12"></line>
                            <line x1="8" y1="18" x2="21" y2="18"></line>
                            <line x1="3" y1="6" x2="3.01" y2="6"></line>
                            <line x1="3" y1="12" x2="3.01" y2="12"></line>
                            <line x1="3" y1="18" x2="3.01" y2="18"></line>
                        </svg>
                    </span>
                    Category Items
                </h1>
                <p class="page-subtitle">Manage items within this category</p>
            </div>

            <a asp-controller="CategoryItems" asp-area="Admin" asp-route-Categoryid="@ViewBag.Categoryid" asp-action="Create" class="btn-create">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
                Create New Item
            </a>
        </div>

        <!-- Stats Panel -->
        <div class="stats-panel">
            <div class="stat-item">
                <span class="stat-label">Total Items</span>
                <span class="stat-value">@Model.Count()</span>
            </div>
            <div class="stat-item">
                <span class="stat-label">Latest Update</span>
                <span class="stat-value">@(Model.Any() ? Model.Max(m => m.DateTimeItemAdded).ToString("MMM dd") : "N/A")</span>
            </div>
        </div>
    </div>

    <!-- Items List -->
    @if (Model.Any())
    {
        <div class="items-list">
            @foreach (var item in Model)
            {
                <div class="item-card">
                    <!-- Item Icon -->
                    <div class="item-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                            <polyline points="14 2 14 8 20 8"></polyline>
                            <line x1="16" y1="13" x2="8" y2="13"></line>
                            <line x1="16" y1="17" x2="8" y2="17"></line>
                            <polyline points="10 9 9 9 8 9"></polyline>
                        </svg>
                    </div>

                    <!-- Item Content -->
                    <div class="item-content">
                        <div class="item-main">
                            <h3 class="item-title">@item.Title</h3>
                            <p class="item-description">
                                @(item.Description?.Length > 120 ? item.Description.Substring(0, 120) + "..." : item.Description ?? "No description available")
                            </p>
                        </div>

                        <div class="item-meta">
                            <div class="meta-info">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <polyline points="12 6 12 12 16 14"></polyline>
                                </svg>
                                <span>@item.DateTimeItemAdded.ToString("MMM dd, yyyy")</span>
                            </div>
                        </div>
                    </div>

                    <!-- Item Actions -->
                    <div class="item-actions">
                        <a asp-controller="CategoryItems" asp-area="Admin" asp-action="Edit" asp-route-id="@item.Id" class="action-btn btn-edit" title="Edit">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                            </svg>
                            <span class="btn-text">Edit</span>

                            @if (item.contentId != 0)
                            {
                                <a asp-controller="Content" asp-area="Admin" asp-action="Edit" asp-route-id="@item.contentId" class="action-btn btn-add" title="Edit Content">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <line x1="12" y1="5" x2="12" y2="19"></line>
                                        <line x1="5" y1="12" x2="19" y2="12"></line>
                                    </svg>
                                    <span class="btn-text">Edit Content</span>
                                </a>

                            }
                            else
                            {
                                <a asp-controller="Content" asp-area="Admin" asp-action="Create" asp-route-categoryItemId="@item.Id" asp-route-categoryId="@item.CategoryId" class="action-btn btn-add" title="Add Content">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <line x1="12" y1="5" x2="12" y2="19"></line>
                                        <line x1="5" y1="12" x2="19" y2="12"></line>
                                    </svg>
                                    <span class="btn-text">Create Content</span>
                                </a>
                            }
                        </a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="action-btn btn-view" title="Details">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                            <span class="btn-text">Details</span>
                        </a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="action-btn btn-delete" title="Delete">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="3 6 5 6 21 6"></polyline>
                                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                            </svg>
                            <span class="btn-text">Delete</span>
                        </a>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <!-- Empty State -->
        <div class="empty-state">
            <div class="empty-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                    <polyline points="14 2 14 8 20 8"></polyline>
                    <line x1="9" y1="15" x2="15" y2="15"></line>
                </svg>
            </div>
            <h3 class="empty-title">No Items Yet</h3>
            <p class="empty-description">Start adding items to this category to build your content library</p>
            <a asp-action="Create" class="btn-create-empty">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
                Create First Item
            </a>
        </div>
    }
</div>