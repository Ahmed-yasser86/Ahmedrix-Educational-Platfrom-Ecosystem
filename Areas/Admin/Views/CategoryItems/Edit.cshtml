@model OnlineCoursesPlatform.Entities.CategoryItem

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>CategoryItem</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="CategoryId" value=@Model.CategoryId></>

            <div class="form-group">
                <label asp-for="Title" class="control-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Description" class="control-label"></label>
                <textarea asp-for="Description" rows="5" class="form-control"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="DateTimeItemAdded" class="control-label"></label>
                <input asp-for="DateTimeItemAdded" class="form-control" />
                <span asp-validation-for="DateTimeItemAdded" class="text-danger"></span>
            </div>
 
            <div class="form-group">
                              <label asp-for="MediaTypeId" class="control-label"></label>
                <select asp-for="MediaTypeId" class="form-control" asp-items="@Model.MediaTypes">
                    <option value="">--Please Select a Media Type--</option>
                </select>
                <span asp-validation-for="MediaTypeId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>


<div>
    <a asp-controller="CategoryItems" asp-area="Admin" asp-action="Index" asp-route-CategoryId="@Model.CategoryId">Back To List</a>

</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
