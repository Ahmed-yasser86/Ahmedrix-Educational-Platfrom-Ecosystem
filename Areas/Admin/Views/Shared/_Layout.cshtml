<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Dashboard</title>

    <!-- Google Web Fonts -->
    <link rel="preconnect" href="https://fonts.gstatic.com">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet">

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Custom Admin CSS -->
    <link rel="stylesheet" href="~/css/admin.css" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="admin-body">
    <!-- AI Admin Assistant -->
    <div class="ai-admin-assistant" id="aiAdminAssistant">
        <i class="fas fa-robot"></i>
        <span class="ai-pulse"></span>
        <div class="ai-tooltip">AI Admin Assistant</div>
    </div>

    <!-- Admin Sidebar -->
    <div class="admin-container">
        <aside class="admin-sidebar">
            <!-- Brand -->
            <div class="sidebar-brand">
                <a asp-area="Admin" asp-controller="Category" asp-action="Index" class="text-decoration-none">
                    <div class="brand-content">
                        <i class="fas fa-brain text-primary"></i>
                        <div class="brand-text">
                            <h4 class="m-0"><span class="text-primary">AI</span>Admin</h4>
                            <small class="text-muted">Dashboard</small>
                        </div>
                    </div>
                </a>
            </div>

            <!-- User Profile -->
            <div class="sidebar-user">
                <div class="user-avatar">
                    <img src="~/images/admin-avatar.jpg" alt="Admin">
                    <span class="status-indicator online"></span>
                </div>
                <div class="user-info">
                    <h6 class="mb-0">Administrator</h6>
                    <small class="text-muted">Super Admin</small>
                </div>
            </div>

            <!-- Navigation -->
            <nav class="sidebar-nav">
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link" asp-area="Admin" asp-controller="Category" asp-action="Index">

                            <i class="fas fa-layer-group"></i>

                            <span>Categories</span>

                            @if (ViewData["CategoryCount"] != null)

                            {

                                <span class="badge bg-primary float-end">@ViewData["CategoryCount"]</span>

                            }

                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-area="Admin" asp-controller="AdminInstructors" asp-action="Index">
                            <i class="fas fa-chalkboard-teacher"></i> <span>Instructors</span>
                            @if (ViewData["InstructorCount"] != null)
                            {
                                <span class="badge bg-primary float-end">@ViewData["InstructorCount"]</span>
                            }
                        </a>
                    </li>
                    <li class="nav-item">

                    <a class="nav-link" asp-area="Admin" asp-controller="AdminAppointments" asp-action="AdminIndex">
                        <i class="fas fa-calendar-alt"></i>
                        <span>Appointments</span>
                    </a>
                    </li>

                    <li class="nav-item">

                        <a class="nav-link" asp-area="Admin" asp-controller="UsersToCategory" asp-action="Index">
                            <i class="fas fa-calendar-alt"></i>
                            <span>UsersToCategory</span>
                        </a>
                    </li>


                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Streams" ? "active" : "")"
                           asp-area="Admin" asp-controller="Streams" asp-action="Create">
                            <i class="fas fa-broadcast-tower text-danger"></i>
                            <span>Go Live 🔴</span>
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-area="Admin" asp-controller="Streams" asp-action="Index">
                            <i class="fas fa-video"></i>
                            <span>Active Streams</span>
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-area="Admin" asp-controller="MediaType" asp-action="Index">
                            <i class="fas fa-photo-video"></i>
                            <span>Media Types</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">
                            <i class="fas fa-home"></i>
                            <span>Main Site</span>
                        </a>
                    </li>
                </ul>
            </nav>
                    

            <!-- Quick Stats -->
            <div class="sidebar-stats">
                <div class="stats-item">
                    <small class="text-muted">Active Users</small>
                    <h5 class="mb-0">@(ViewData["ActiveUsers"] ?? "0")</h5>
                </div>
                <div class="stats-item">
                    <small class="text-muted">Categories</small>
                    <h5 class="mb-0">@(ViewData["CategoryCount"] ?? "0")</h5>
                </div>
            </div>

            <!-- Logout -->
            <div class="sidebar-footer">
                <a asp-area="Identity" asp-page="/Account/Logout" class="nav-link">
                    <i class="fas fa-sign-out-alt"></i>
                    <span>Logout</span>
                </a>
            </div>
        </aside>

        <!-- Main Content -->
        <main class="admin-main">
            <!-- Top Bar -->
            <header class="admin-topbar">
                <div class="container-fluid">
                    <div class="row align-items-center">
                        <div class="col-md-6">
                            <button class="sidebar-toggle" id="sidebarToggle">
                                <i class="fas fa-bars"></i>
                            </button>
                            <nav aria-label="breadcrumb">
                                <ol class="breadcrumb mb-0">
                                    <li class="breadcrumb-item">
                                        <a asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                                    </li>
                                    <li class="breadcrumb-item active">@ViewData["Title"]</li>
                                </ol>
                            </nav>
                        </div>
                        <div class="col-md-6 text-end">
                            <div class="d-inline-flex align-items-center">
                                <!-- Quick Actions -->
                                <div class="dropdown">
                                    <button class="btn btn-primary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                        <i class="fas fa-cogs"></i> Quick Actions
                                    </button>
                                    <div class="dropdown-menu dropdown-menu-end">
                                        <a class="dropdown-item" asp-area="Admin" asp-controller="Category" asp-action="Create">
                                            <i class="fas fa-plus-circle"></i> Add Category
                                        </a>
                                        <a class="dropdown-item" asp-area="Admin" asp-controller="CategoryItems" asp-action="Create" asp-route-categoryId="0">
                                            <i class="fas fa-plus"></i> Add Category Item
                                        </a>
                                        <a class="dropdown-item" asp-area="Admin" asp-controller="MediaType" asp-action="Create">
                                            <i class="fas fa-photo-video"></i> Add Media Type
                                        </a>
                                        <div class="dropdown-divider"></div>
                                        <a class="dropdown-item" asp-area="" asp-controller="Home" asp-action="Index">
                                            <i class="fas fa-external-link-alt"></i> Go to Main Site
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </header>

            <!-- Page Content -->
            <div class="admin-content">
                <div class="container-fluid py-4">
                    @RenderBody()
                </div>
            </div>

            <!-- Footer -->
            <footer class="admin-footer">
                <div class="container-fluid">
                    <div class="row align-items-center">
                        <div class="col-md-6">
                            <p class="mb-0 text-muted">
                                <i class="fas fa-shield-alt"></i> Admin Panel •
                                <span class="text-primary">AI-Powered Management</span>
                            </p>
                        </div>
                        <div class="col-md-6 text-end">
                            <small class="text-muted">
                                @DateTime.Now.ToString("MMM dd, yyyy HH:mm") •
                                <span class="text-success"><i class="fas fa-circle"></i> Online</span>
                            </small>
                        </div>
                    </div>
                </div>
            </footer>
        </main>
    </div>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Admin Custom JS -->
    <script src="~/js/admin.js" asp-append-version="true"></script>

    <script>
        // Sidebar toggle
        document.getElementById('sidebarToggle').addEventListener('click', function () {
            document.querySelector('.admin-container').classList.toggle('sidebar-collapsed');
        });

        // AI Assistant toggle
        document.getElementById('aiAdminAssistant').addEventListener('click', function () {
            // Simple AI assistant functionality
            const question = prompt('AI Admin Assistant: How can I help you?');
            if (question) {
                alert('I\'ll help you with: ' + question + '\n\nThis feature will be enhanced with real AI integration.');
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
