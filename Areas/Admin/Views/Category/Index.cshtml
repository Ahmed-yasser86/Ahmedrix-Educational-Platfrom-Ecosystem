@model IEnumerable<OnlineCoursesPlatform.Entities.Category>
@{
    ViewData["Title"] = "Categories Management";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-panel.css?v=@DateTime.Now.Ticks" />
}

@section Scripts {
    <script src="~/js/admin-panel.js?v=@DateTime.Now.Ticks"></script>
}

<div class="admin-categories-container">
    <!-- Header Section -->
    <div class="categories-header">
        <div class="header-content">
            <div class="header-text">
                <h1 class="page-title">
                    <span class="title-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                            <polyline points="22,6 12,13 2,6"></polyline>
                        </svg>
                    </span>
                    Categories Management
                </h1>
                <p class="page-subtitle">Organize and manage your course categories with AI-powered insights</p>
            </div>
            <a asp-action="Create" class="btn-create">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
                Create Category
            </a>
        </div>

        <!-- AI Insights Panel -->
        <div class="ai-insights-panel">
            <div class="insight-item">
                <span class="insight-label">Total Categories</span>
                <span class="insight-value">@Model.Count()</span>
            </div>
            <div class="insight-item">
                <span class="insight-label">AI Status</span>
                <span class="insight-value active">
                    <span class="status-dot"></span>
                    Active
                </span>
            </div>
            <div class="insight-item">
                <span class="insight-label">Last Updated</span>
                <span class="insight-value">@DateTime.Now.ToString("MMM dd, yyyy")</span>
            </div>
        </div>
    </div>

 
    <!-- Categories Grid -->
    @if (Model.Any())
    {
        <div class="categories-grid" id="categoriesGrid">
            @foreach (var item in Model)
            {
                <div class="category-card" data-category-id="@item.Id">
                    <!-- Card Header with Thumbnail -->
                    <div class="card-thumbnail">
                        @if (!string.IsNullOrEmpty(item.ThumbnailImagePath))
                        {
                            <img src="@item.ThumbnailImagePath" alt="@item.Title" class="thumbnail-image">
                        }
                        else
                        {
                            <div class="thumbnail-placeholder">
                                <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                                    <circle cx="8.5" cy="8.5" r="1.5"></circle>
                                    <polyline points="21 15 16 10 5 21"></polyline>
                                </svg>
                            </div>
                        }
                        <div class="card-overlay">
                            <div class="ai-score">
                                <span class="score-label">AI Score</span>
                                <span class="score-value">@(new Random().Next(75, 99))</span>
                            </div>
                        </div>
                    </div>

                    <!-- Card Content -->
                    <div class="card-content">
                        <h3 class="category-title">@item.Title</h3>
                        <p class="category-description">
                            @(item.Description?.Length > 100 ? item.Description.Substring(0, 100) + "..." : item.Description ?? "No description available")
                        </p>

                        <!-- AI Insights Tags -->
                        <div class="category-tags">
                            <span class="tag tag-primary">Active</span>
                            <span class="tag tag-ai">AI Optimized</span>
                        </div>

                        <!-- Action Buttons -->
                        <div class="card-actions">

                           <a asp-controller="Category" asp-area="Admin" asp-action="Edit" asp-route-id="@item.Id" class="action-btn btn-edit" title="Edit">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                                </svg>
                            </a>
                            <a asp-controller="Category" asp-area="Admin" asp-route-id="@item.Id" class="action-btn btn-view" title="Details">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                    <circle cx="12" cy="12" r="3"></circle>
                                </svg>
                            </a>
                            <a asp-controller="CategoryItems" asp-area="Admin" asp-action="Index" asp-route-CategoryId="@item.Id" class="action-btn btn-items" title="Manage Items">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <line x1="8" y1="6" x2="21" y2="6"></line>
                                    <line x1="8" y1="12" x2="21" y2="12"></line>
                                    <line x1="8" y1="18" x2="21" y2="18"></line>
                                    <line x1="3" y1="6" x2="3.01" y2="6"></line>
                                    <line x1="3" y1="12" x2="3.01" y2="12"></line>
                                    <line x1="3" y1="18" x2="3.01" y2="18"></line>
                                </svg>
                            </a>
                            <a asp-controller="Category" asp-area="Admin" asp-action="Delete" asp-route-id="@item.Id" class="action-btn btn-delete" title="Delete">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <polyline points="3 6 5 6 21 6"></polyline>
                                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                </svg>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <!-- Empty State -->
        <div class="empty-state">
            <div class="empty-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                    <line x1="9" y1="9" x2="15" y2="15"></line>
                    <line x1="15" y1="9" x2="9" y2="15"></line>
                </svg>
            </div>
            <h3 class="empty-title">No Categories Found</h3>
            <p class="empty-description">Start building your course library by creating your first category</p>
            <a asp-action="Create" class="btn-create-empty">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
                Create First Category
            </a>
        </div>
    }
</div>