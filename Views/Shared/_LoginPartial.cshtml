@using Microsoft.AspNetCore.Identity
@using OnlineCoursesPlatform.Data;
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
<ul class="navbar-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item">
            <a class="nav-link text-dark"  >Hello @User.Identity?.Name!</a>
        </li>
        <li class="nav-item">
            <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                <button type="submit" class="nav-link btn btn-link text-dark">Logout</button>
            </form>
        </li>
    }
    else
    {
        <a class="nav-link text-dark" asp-area="Identity" 
           data-bs-toggle="modal" data-bs-target="#UserLoginModal">
            <i class="fas fa-sign-in-alt mr-1 text-info"></i>Login
        </a>


        <a class="nav-link text-dark" asp-area="Identity" 
           data-bs-toggle="modal" data-bs-target="#UserRegistrationModal">
            <i class="fas fa-user-plus mr-1 text-info"></i>Register
        </a>

    }
</ul>
