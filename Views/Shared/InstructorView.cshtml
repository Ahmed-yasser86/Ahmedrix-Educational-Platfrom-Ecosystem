@model List<OnlineCoursesPlatform.Models.Instructor>

@{
    ViewData["Title"] = "Instructors";
}

<div class="container-fluid py-5">
    <div class="container pt-5 pb-3">
        <div class="text-center mb-5">
            <h5 class="text-primary text-uppercase mb-3" style="letter-spacing: 5px;">Our Team</h5>
            <h1>Expert Instructors</h1>
            <p>Meet our team of professional experts</p>
        </div>

        @if (!Model.Any())
        {
            <div class="text-center">
                <p class="text-muted">No instructors available at the moment</p>
            </div>
        }
        else
        {
            <div class="row">
                @foreach (var instructor in Model)
                {
                    <div class="col-lg-3 col-md-6 mb-4">
                        <div class="instructor-card card border-0 shadow-sm rounded h-100">
                            <div class="position-relative overflow-hidden rounded-top">
                                @if (!string.IsNullOrEmpty(instructor.ProfileImagePath))
                                {
                                    <img src="@instructor.ProfileImagePath"
                                         class="card-img-top instructor-img"
                                         alt="@instructor.Name"
                                         style="height: 250px; object-fit: cover;">
                                }
                                else
                                {
                                    <div class="placeholder-img d-flex align-items-center justify-content-center bg-light"
                                         style="height: 250px;">
                                        <i class="fas fa-user-circle fa-5x text-muted"></i>
                                    </div>
                                }
                            </div>

                            <div class="card-body text-center py-4">
                                <h5 class="card-title mb-2">@instructor.Name</h5>
                                <p class="text-muted mb-3">
                                    <i class="fas fa-envelope me-2"></i>
                                    @instructor.Email
                                </p>

                                @if (!string.IsNullOrEmpty(instructor.Description))
                                {
                                    <p class="card-text text-muted mb-4">
                                        @instructor.Description
                                    </p>
                                }

                                @if (instructor.Courses != null && instructor.Courses.Any())
                                {
                                    <div class="mt-3">
                                        <h6 class="text-primary mb-3">Specializations:</h6>
                                        <div class="d-flex flex-wrap justify-content-center gap-2">
                                            @foreach (var course in instructor.Courses.Take(3))
                                            {
                                                <span class="badge bg-light text-dark border py-2 px-3">
                                                    @course.Title
                                                </span>
                                            }
                                            @if (instructor.Courses.Count > 3)
                                            {
                                                <span class="badge bg-secondary py-2 px-3">
                                                    +@(instructor.Courses.Count - 3) more
                                                </span>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<style>
    .instructor-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .instructor-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
        }

    .instructor-img {
        transition: transform 0.5s ease;
    }

    .instructor-card:hover .instructor-img {
        transform: scale(1.05);
    }

    .placeholder-img {
        background: linear-gradient(45deg, #f8f9fa, #e9ecef);
    }

    .badge {
        font-size: 0.85rem;
        font-weight: 500;
    }
</style>