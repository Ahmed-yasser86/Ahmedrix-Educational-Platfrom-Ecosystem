@model IEnumerable<StudentLiveViewModel>

@{
    ViewData["Title"] = "My Live Lectures";
}

<div class="container-fluid py-4">
    <div class="d-flex align-items-center mb-4">
        <i class="fas fa-play-circle text-primary fa-2x me-2"></i>
        <h2 class="mb-0">Live Streams</h2>
    </div>

    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-xl-4 col-md-6 mb-4">
                <div class="card h-100 shadow-sm border-0 position-relative overflow-hidden" style="border-radius: 15px; transition: transform 0.3s;">

                    @if (item.IsLiveNow)
                    {
                        <div class="position-absolute top-0 end-0 m-3">
                            <span class="badge bg-danger d-flex align-items-center p-2 shadow">
                                <span class="spinner-grow spinner-grow-sm me-1" role="status"></span>
                                LIVE NOW
                            </span>
                        </div>
                    }

                    <div class="card-body p-4">
                        <div class="d-flex align-items-center mb-3">
                            <div class="icon-shape bg-light-primary rounded-circle p-3 me-3">
                                <i class="fas fa-book-reader text-primary fa-lg"></i>
                            </div>
                            <h5 class="card-title mb-0">@item.CategoryTitle</h5>
                        </div>

                        <p class="text-muted small mb-4">
                            @(item.IsLiveNow ? "The instructor has started teaching. Join the session now!" : "No live sessions available for this course at the moment.")
                        </p>

                        <div class="d-grid mt-auto">
                            @if (item.IsLiveNow)
                            {
                                <a asp-action="Watch" asp-route-key="@item.StreamKey" class="btn btn-primary btn-lg rounded-pill shadow">
                                    <i class="fas fa-sign-in-alt me-2"></i> Join Live Session
                                </a>
                            }
                            else
                            {
                                <button class="btn btn-outline-secondary btn-lg rounded-pill disabled">
                                    <i class="fas fa-clock me-2"></i> Currently Unavailable
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .bg-light-primary {
        background-color: rgba(13, 110, 253, 0.1);
    }

    .card:hover {
        transform: translateY(-5px);
    }
</style>