@model IEnumerable<OnlineCoursesPlatform.Entities.Category>

<div class="container py-5">
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="display-6 fw-bold text-dark border-bottom pb-3">
                <i class="fas fa-layer-group text-primary me-2"></i>My Study Groups
            </h2>
        </div>
    </div>

    <div class="row">
        @foreach (var category in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 border-0 shadow-sm" style="border-radius: 15px; transition: transform 0.2s;">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center mb-3">
                            <div class="flex-shrink-0 bg-primary-subtle p-3 rounded-3">
                                <i class="fas fa-comments fa-2x text-primary"></i>
                            </div>
                            <div class="ms-3">
                                <h5 class="card-title mb-0 fw-bold">@category.Title</h5>
                                <small class="text-muted">Chat Room Active</small>
                            </div>
                        </div>
                        <p class="card-text text-secondary small">Join the community discussion for @category.Title and share knowledge.</p>
                        <a asp-action="Room" asp-route-id="@category.Id" class="btn btn-primary w-100 rounded-pill fw-bold">
                            Open Discussion
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .hover-lift:hover {
        transform: translateY(-5px);
    }
</style>