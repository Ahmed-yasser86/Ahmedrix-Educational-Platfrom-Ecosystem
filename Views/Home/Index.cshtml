@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // Auto-open first category for better UX
        document.addEventListener('DOMContentLoaded', function() {
            const firstCategory = document.querySelector('.card-title a');
            if (firstCategory) {
                const collapseId = firstCategory.getAttribute('data-bs-target');
                const collapseElement = document.querySelector(collapseId);
                if (collapseElement) {
                    new bootstrap.Collapse(collapseElement, {
                        toggle: false
                    }).show();
                }
            }
        });

        // Smooth scroll for anchor links
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function(e) {
                e.preventDefault();
                const targetId = this.getAttribute('href');
                if (targetId !== '#') {
                    const targetElement = document.querySelector(targetId);
                    if (targetElement) {
                        window.scrollTo({
                            top: targetElement.offsetTop - 100,
                            behavior: 'smooth'
                        });
                    }
                }
            });
        });
    </script>
}

<style>
    .hover-lift {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .hover-lift:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.1) !important;
        }

    .course-item {
        transition: background-color 0.3s ease;
    }

        .course-item:hover {
            background-color: rgba(13, 110, 253, 0.05) !important;
        }

    .category-items-list {
        max-height: 400px;
        overflow-y: auto;
        padding-right: 5px;
    }

        .category-items-list::-webkit-scrollbar {
            width: 5px;
        }

        .category-items-list::-webkit-scrollbar-track {
            background: #f1f1f1;
            border-radius: 10px;
        }

        .category-items-list::-webkit-scrollbar-thumb {
            background: #888;
            border-radius: 10px;
        }

            .category-items-list::-webkit-scrollbar-thumb:hover {
                background: #555;
            }

    .card-header {
        cursor: pointer;
    }

    .progress {
        border-radius: 10px;
        overflow: hidden;
    }

    .progress-bar {
        border-radius: 10px;
    }
</style>