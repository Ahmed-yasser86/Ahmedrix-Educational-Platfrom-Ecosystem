@model OnlineCoursesPlatform.Entities.Content

<div class="content-wrapper py-4">
    <div class="container">
        <div class="mb-4">
            <h1 class="display-5 fw-bold text-primary">@Model.Title</h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/">Home</a></li>
                    <li class="breadcrumb-item active">@Model.Title</li>
                </ol>
            </nav>
        </div>

        <div class="row g-4">
            <div class="col-lg-9">

                @if (!string.IsNullOrEmpty(Model.VideoLink))
                {
                    <div class="card border-0 shadow-sm overflow-hidden mb-4 bg-dark">
                        <div class="ratio ratio-16x9">
                            <iframe src="@Model.VideoLink"
                                    title="Course Video"
                                    allowfullscreen
                                    frameborder="0"></iframe>
                        </div>
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.HTMLContent))
                {
                    <div class="card border-0 shadow-sm mb-4">
                        <div class="card-body p-4">
                            <h4 class="card-title mb-4 fw-bold"><i class="bi bi-file-text me-2"></i> الدرس: وصف وملاحظات</h4>
                            <hr />
                            <div class="article-content" style="line-height: 1.8; font-size: 1.1rem;">
                                @Html.Raw(Model.HTMLContent)
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="col-lg-3">
                <div class="card border-0 shadow-sm sticky-top" style="top: 20px;">
                    <div class="card-body">
                        <h5 class="fw-bold mb-3">Resources</h5>
                        <ul class="list-group list-group-flush">
                            <li class="list-group-item d-flex align-items-center border-0 px-0">
                                <i class="bi bi-file-earmark-pdf text-danger me-2"></i>
                                <a href="#" class="text-decoration-none text-dark">Lecture Slides</a>
                            </li>
                            <li class="list-group-item d-flex align-items-center border-0 px-0">
                                <i class="bi bi-code-slash text-primary me-2"></i>
                                <a href="#" class="text-decoration-none text-dark">Source Code</a>
                            </li>
                        </ul>
                        <div class="d-grid mt-4">
                            <button class="btn btn-success rounded-pill">Mark as Completed</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .article-content img {
        max-width: 100%;
        height: auto;
        border-radius: 8px;
    }

    .video-container {
        border-radius: 12px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    }

    .card {
        border-radius: 12px;
    }

    body {
        background-color: #f8f9fa; 
    }
</style>